<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
  <title>Studio Vitória Makup · Designer & Maquiadora</title>
  <!-- Google Fonts - Droid Serif -->
  <link href="https://fonts.googleapis.com/css2?family=Droid+Serif:wght@400;700&display=swap" rel="stylesheet" />
  <!-- Swiper CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <!-- ScrollReveal -->
  <script src="https://unpkg.com/scrollreveal@4.0.0/dist/scrollreveal.min.js"></script>
  <style>
    /* ===== RESET & BASE ===== */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    html {
      scroll-behavior: smooth;
    }
    body {
      font-family: 'Droid Serif', 'Segoe UI', 'Helvetica Neue', serif;
      background: #fcf8f5;
      color: #3d2c24;
      line-height: 1.6;
      overflow-x: hidden;
    }
    a {
      text-decoration: none;
      color: inherit;
    }
    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* ===== ANIMAÇÕES GLOBAIS ===== */
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }
    @keyframes pulse-glow {
      0%, 100% { box-shadow: 0 0 20px rgba(212, 175, 55, 0.15); }
      50% { box-shadow: 0 0 50px rgba(212, 175, 55, 0.25); }
    }
    @keyframes shimmer {
      0% { background-position: -200% center; }
      100% { background-position: 200% center; }
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(40px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.92); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes gradient-shift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* ===== TIPOGRAFIA ===== */
    h1, h2, h3 {
      font-weight: 400;
      letter-spacing: 0.02em;
      font-family: 'Droid Serif', serif;
    }
    .section-title {
      font-size: 3rem;
      text-align: center;
      margin-bottom: 1.2rem;
      color: #4a342b;
      position: relative;
      font-weight: 400;
      font-family: 'Droid Serif', serif;
    }
    .section-title span {
      background: linear-gradient(135deg, #c9a88b, #b58a6b);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      position: relative;
    }
    .section-title::after {
      content: '';
      position: absolute;
      bottom: -14px;
      left: 50%;
      transform: translateX(-50%);
      width: 70px;
      height: 3px;
      background: linear-gradient(90deg, #d4af37, #c9a88b, #d4af37);
      border-radius: 4px;
      background-size: 200% 100%;
      animation: gradient-shift 3s ease-in-out infinite;
    }
    .section-sub {
      text-align: center;
      color: #7a6254;
      margin-bottom: 2.5rem;
      font-size: 1.2rem;
      letter-spacing: 1px;
      font-weight: 300;
      font-family: 'Droid Serif', serif;
    }

    /* ===== BOTÕES ===== */
    .btn {
      display: inline-block;
      padding: 0.9rem 2.8rem;
      border-radius: 50px;
      font-weight: 500;
      border: none;
      background: #c9a88b;
      color: #fff;
      box-shadow: 0 12px 24px -8px rgba(128, 88, 64, 0.25);
      transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      cursor: pointer;
      backdrop-filter: blur(4px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      letter-spacing: 0.5px;
      position: relative;
      overflow: hidden;
      font-family: 'Droid Serif', serif;
    }
    .btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      transition: left 0.6s;
    }
    .btn:hover::before {
      left: 100%;
    }
    .btn-outline {
      background: transparent;
      border: 1.5px solid #c9a88b;
      color: #c9a88b;
      box-shadow: none;
      backdrop-filter: blur(2px);
    }
    .btn-outline:hover {
      background: #c9a88b;
      color: #fff;
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 15px 30px -10px rgba(128, 88, 64, 0.3);
    }
    .btn:hover {
      transform: translateY(-4px) scale(1.02);
      box-shadow: 0 20px 40px -10px rgba(128, 88, 64, 0.4);
    }
    .btn-gold {
      background: linear-gradient(135deg, #d4af37, #c9a030);
      border-color: #d4af37;
      color: #2d1f1a;
      box-shadow: 0 12px 30px -8px rgba(212, 175, 55, 0.3);
    }
    .btn-gold:hover {
      transform: translateY(-4px) scale(1.03);
      box-shadow: 0 20px 40px -10px rgba(212, 175, 55, 0.5);
    }

    /* ===== HEADER ===== */
    .navbar {
      padding: 1rem 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      background: rgba(252, 248, 245, 0.88);
      backdrop-filter: blur(20px) saturate(1.2);
      border-bottom: 1px solid rgba(255,255,255,0.15);
      transition: all 0.4s ease;
      padding-left: 2rem;
      padding-right: 2rem;
    }
    .navbar.scrolled {
      background: rgba(252, 248, 245, 0.96);
      box-shadow: 0 4px 40px rgba(0,0,0,0.06);
    }
    .logo {
      font-size: 1.6rem;
      font-weight: 400;
      letter-spacing: 1px;
      color: #4a342b;
      transition: transform 0.3s ease;
      font-family: 'Droid Serif', serif;
    }
    .logo:hover {
      transform: scale(1.03);
    }
    .logo span {
      font-weight: 700;
      color: #d4af37;
      letter-spacing: 1px;
      text-shadow: 0 2px 15px rgba(212, 175, 55, 0.15);
    }
    .nav-links {
      display: flex;
      gap: 2.5rem;
      font-weight: 400;
      color: #4a342b;
      font-family: 'Droid Serif', serif;
    }
    .nav-links a {
      transition: all 0.3s ease;
      border-bottom: 2px solid transparent;
      padding-bottom: 4px;
      position: relative;
      font-size: 0.95rem;
    }
    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 0;
      height: 2px;
      background: linear-gradient(90deg, #d4af37, #c9a88b);
      transition: width 0.3s ease;
    }
    .nav-links a:hover::after {
      width: 100%;
    }
    .nav-links a:hover {
      color: #7a4f3a;
    }

    /* ===== HERO - SEM IMAGENS ===== */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f5ede7;
      overflow: hidden;
      padding: 7rem 0 3rem;
      text-align: center;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 30% 20%, #f0e4db 0%, #e8d9cf 100%);
      z-index: 0;
      opacity: 0.5;
    }
    .hero::after {
      content: '';
      position: absolute;
      top: -50%;
      right: -20%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(212, 175, 55, 0.04) 0%, transparent 70%);
      border-radius: 50%;
      z-index: 0;
    }
    .hero .container {
      position: relative;
      z-index: 2;
      max-width: 900px;
      margin: 0 auto;
    }
    .hero-content h1 {
      font-size: 4.5rem;
      font-weight: 400;
      line-height: 1.1;
      color: #3d2c24;
      animation: fadeInUp 1s ease forwards;
      font-family: 'Droid Serif', serif;
    }
    .hero-content h1 strong {
      font-weight: 700;
      background: linear-gradient(135deg, #c9a88b, #b58a6b);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      position: relative;
    }
    .hero-content .subhead {
      font-size: 1.4rem;
      color: #5f4a3b;
      margin: 1.2rem 0 2.8rem;
      letter-spacing: 1px;
      font-weight: 300;
      animation: fadeInUp 1s ease 0.2s forwards;
      opacity: 0;
      font-family: 'Droid Serif', serif;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.6;
    }
    .hero-buttons {
      display: flex;
      gap: 1.2rem;
      flex-wrap: wrap;
      justify-content: center;
      animation: fadeInUp 1s ease 0.4s forwards;
      opacity: 0;
    }

    /* ===== REDES SOCIAIS ===== */
    .social-prime {
      padding: 2.5rem 0 3.5rem;
      background: #fcf8f5;
      text-align: center;
      position: relative;
    }
    .social-prime::before {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 80%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.15), transparent);
    }
    .social-prime .social-icons {
      display: flex;
      justify-content: center;
      gap: 2.5rem;
      flex-wrap: wrap;
    }
    .social-prime .social-icons a {
      background: rgba(255, 247, 240, 0.7);
      backdrop-filter: blur(10px);
      width: 80px;
      height: 80px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.6rem;
      color: #4a342b;
      border: 1px solid rgba(212, 175, 55, 0.15);
      transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.04);
      position: relative;
    }
    .social-prime .social-icons a::before {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: 50%;
      padding: 3px;
      background: linear-gradient(135deg, #d4af37, #c9a88b, #d4af37);
      background-size: 300% 300%;
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0;
      transition: opacity 0.5s ease;
    }
    .social-prime .social-icons a:hover::before {
      opacity: 1;
      animation: shimmer 2s linear infinite;
    }
    .social-prime .social-icons a:hover {
      transform: translateY(-12px) scale(1.08);
      background: #d4af37;
      color: #fff;
      border-color: #d4af37;
      box-shadow: 0 25px 40px -12px rgba(212, 175, 55, 0.3);
    }

    /* ===== GALERIA INTERATIVA ===== */
    .services-gallery {
      padding: 6rem 0;
      background: #fcf8f5;
      position: relative;
    }
    .services-gallery::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.2), transparent);
    }
    .swiper {
      width: 100%;
      padding: 2rem 0 3.5rem;
    }
    .swiper-slide {
      background: transparent;
      border-radius: 32px;
      transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      text-align: center;
    }
    .swiper-slide img {
      width: 100%;
      height: 420px;
      object-fit: cover;
      border-radius: 32px;
      box-shadow: 0 20px 50px -12px rgba(60, 40, 30, 0.12);
      transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      border: 3px solid rgba(255, 255, 255, 0.4);
    }
    .swiper-slide:hover img {
      transform: scale(1.03) translateY(-6px);
      box-shadow: 0 35px 60px -18px rgba(60, 40, 30, 0.2);
      border-color: rgba(212, 175, 55, 0.25);
    }
    .swiper-slide::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 40%;
      background: linear-gradient(to top, rgba(60, 40, 30, 0.08), transparent);
      border-radius: 0 0 32px 32px;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.5s ease;
    }
    .swiper-slide:hover::after {
      opacity: 1;
    }
    .swiper-button-next,
    .swiper-button-prev {
      color: #d4af37;
      background: rgba(255, 247, 240, 0.85);
      backdrop-filter: blur(12px);
      border-radius: 50%;
      width: 56px;
      height: 56px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
      transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      border: 1px solid rgba(212, 175, 55, 0.12);
    }
    .swiper-button-next:hover,
    .swiper-button-prev:hover {
      background: #d4af37;
      color: #fff;
      transform: scale(1.1);
      box-shadow: 0 12px 35px rgba(212, 175, 55, 0.2);
    }
    .swiper-button-next::after,
    .swiper-button-prev::after {
      font-size: 1.4rem;
      font-weight: 700;
    }
    .swiper-pagination-bullet {
      background: #c9a88b;
      opacity: 0.25;
      width: 10px;
      height: 10px;
      transition: all 0.3s ease;
    }
    .swiper-pagination-bullet-active {
      opacity: 1;
      background: #d4af37;
      width: 32px;
      border-radius: 6px;
      box-shadow: 0 0 25px rgba(212, 175, 55, 0.25);
    }

    /* ===== SOBRE ===== */
    .about {
      padding: 6rem 0;
      background: linear-gradient(180deg, #f5ede7 0%, #fcf8f5 100%);
      position: relative;
    }
    .about::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.25), transparent);
    }
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: center;
    }
    .about-img {
      position: relative;
    }
    .about-img::before {
      content: '';
      position: absolute;
      inset: -10px;
      border-radius: 48px 10px 48px 10px;
      background: linear-gradient(135deg, rgba(212, 175, 55, 0.12), rgba(201, 168, 139, 0.12));
      z-index: -1;
      animation: pulse-glow 4s ease-in-out infinite;
    }
    .about-img img {
      width: 100%;
      border-radius: 40px 8px 40px 8px;
      box-shadow: 0 40px 60px -20px rgba(60, 40, 30, 0.3);
      border: 4px solid rgba(255, 255, 255, 0.5);
      transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .about-img:hover img {
      transform: scale(1.02) rotate(-0.5deg);
      box-shadow: 0 50px 80px -25px rgba(60, 40, 30, 0.4);
    }
    .about-text h2 {
      font-size: 2.8rem;
      font-weight: 400;
      margin-bottom: 1.5rem;
      font-family: 'Droid Serif', serif;
    }
    .about-text h2 span {
      background: linear-gradient(135deg, #c9a88b, #b58a6b);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .about-text h2 .heart {
      color: #8B5E3C;
      display: inline-block;
    }
    .about-text p {
      color: #4f3d32;
      margin-bottom: 1.5rem;
      font-size: 1.1rem;
      line-height: 1.9;
      font-weight: 300;
      font-family: 'Droid Serif', serif;
    }
    .about-text .btn {
      margin-top: 0.5rem;
    }

    /* ===== SERVIÇOS CARDS ===== */
    .services-cards {
      padding: 6rem 0;
      background: #fcf8f5;
      position: relative;
    }
    .services-cards::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.15), transparent);
    }
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2.5rem;
      margin-top: 1.5rem;
      max-width: 750px;
      margin-left: auto;
      margin-right: auto;
    }
    .card-item {
      background: rgba(255, 247, 240, 0.6);
      backdrop-filter: blur(12px);
      padding: 3rem 2rem;
      border-radius: 40px;
      text-align: center;
      border: 1px solid rgba(255, 255, 255, 0.35);
      box-shadow: 0 15px 40px -12px rgba(0, 0, 0, 0.04);
      transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      position: relative;
      overflow: hidden;
    }
    .card-item::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(135deg, rgba(212, 175, 55, 0.04), rgba(201, 168, 139, 0.04));
      opacity: 0;
      transition: opacity 0.6s ease;
    }
    .card-item:hover::before {
      opacity: 1;
    }
    .card-item:hover {
      transform: translateY(-14px) scale(1.02);
      box-shadow: 0 35px 55px -18px rgba(128, 88, 64, 0.12);
      border-color: rgba(212, 175, 55, 0.3);
    }
    .card-item i {
      font-size: 3.5rem;
      color: #d4af37;
      margin-bottom: 0.8rem;
      display: inline-block;
      transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .card-item:hover i {
      transform: scale(1.15) rotate(-5deg);
    }
    .card-item h3 {
      font-size: 1.8rem;
      font-weight: 400;
      margin: 0.5rem 0;
      color: #3d2c24;
      font-family: 'Droid Serif', serif;
    }
    .card-item p {
      color: #6b5546;
      font-size: 1rem;
      font-weight: 300;
      font-family: 'Droid Serif', serif;
    }
    .card-item .btn-small {
      margin-top: 1.8rem;
      padding: 0.5rem 2.2rem;
      border-radius: 50px;
      border: 1px solid #d4af37;
      background: transparent;
      color: #d4af37;
      transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      font-weight: 400;
      display: inline-block;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      font-family: 'Droid Serif', serif;
    }
    .card-item .btn-small::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      transition: left 0.5s ease;
    }
    .card-item .btn-small:hover::before {
      left: 100%;
    }
    .card-item .btn-small:hover {
      background: #d4af37;
      color: #fff;
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -8px rgba(212, 175, 55, 0.3);
    }

    /* ===== RODAPÉ ===== */
    .footer {
      background: #3d2c24;
      color: #e8dcd4;
      padding: 4rem 0 2rem;
      position: relative;
      overflow: hidden;
    }
    .footer::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, #d4af37, transparent);
      opacity: 0.3;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 2.5rem;
      margin-bottom: 2.5rem;
    }
    .footer h4 {
      color: #dccfc6;
      font-weight: 400;
      margin-bottom: 1rem;
      letter-spacing: 2px;
      font-size: 1.1rem;
      font-family: 'Droid Serif', serif;
    }
    .footer a {
      display: block;
      color: #cbb9ad;
      transition: all 0.3s ease;
      margin: 0.4rem 0;
      font-weight: 300;
      font-family: 'Droid Serif', serif;
    }
    .footer a:hover {
      color: #d4af37;
      transform: translateX(4px);
    }
    .footer .social-icons a {
      display: inline-block;
      margin-right: 1.2rem;
      font-size: 1.8rem;
      color: #cbb9ad;
      transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .footer .social-icons a:hover {
      color: #d4af37;
      transform: translateY(-6px) scale(1.1);
    }
    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding-top: 2rem;
      text-align: center;
      font-size: 0.9rem;
      color: #a69284;
      font-weight: 300;
      font-family: 'Droid Serif', serif;
    }
    .footer-message {
      text-align: center;
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      font-size: 1.1rem;
      color: #dccfc6;
      font-weight: 300;
      font-family: 'Droid Serif', serif;
      letter-spacing: 1px;
    }
    .footer-message .heart-emoji {
      color: #8B5E3C;
    }

    /* ===== RESPONSIVIDADE ===== */
    @media (max-width: 992px) {
      .hero-content h1 {
        font-size: 3.4rem;
      }
      .hero-content .subhead {
        font-size: 1.2rem;
      }
      .about-grid {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .section-title {
        font-size: 2.4rem;
      }
